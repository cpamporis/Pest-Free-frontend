{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    },
    "production-voice": {
      "extends": "production",
      "channel": "production-voice",
      "env": {
        "APP_VARIANT": "production",
        "PESTIFY_VOICE_ENABLED": "1",
        "PESTIFY_VOICE_LAB": "0",
        "PESTIFY_VOICE_FIELD_LAB": "0"
      }
    },
    "hetzner-dr-test": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "hetzner-dr-test-20261007",
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_PESTIFY_TARGET": "hetzner-dr-test"
      }
    }
  },
  "submit": {
    "production": {},
    "production-voice": {
      "extends": "production"
    }
  }
}
